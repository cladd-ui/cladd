{
  "name": "@cladd-ui/react",
  "version": "0.3.0",
  "description": "",
  "homepage": "https://cladd.io",
  "bugs": {
    "url": "https://github.com/cladd-ui/cladd/issues"
  },
  "license": "MIT",
  "author": "Vladimir Kharlampidi",
  "repository": {
    "type": "git",
    "url": "https://github.com/cladd-ui/cladd.git"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./cladd.css": {
      "default": "./cladd.css",
      "types": "./cladd.css.d.ts"
    },
    "./css": {
      "default": "./cladd.css",
      "types": "./cladd.css.d.ts"
    },
    "./styles/*": "./styles/*",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  }
}
